{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneAgent",
  "version": "0.1.0",
  "identifier": "com.oneagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:claude-runtime && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneAgent",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/bundled-bun/**/*",
      "resources/external_agents/**/*"
    ]
  }
}
