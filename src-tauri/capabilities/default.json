{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for OneAgent",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:allow-open",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "open-in-finder",
          "cmd": "open",
          "args": [
            "-R",
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "open-in-explorer",
          "cmd": "explorer",
          "args": [
            "/select,",
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "open-file-manager",
          "cmd": "xdg-open",
          "args": [
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
